# Docker Compose reads .env automatically. For a native run, export the variables.
PORT=8000
BIND_ADDRESS=127.0.0.1
STORAGE_BACKEND=local

# Days between fixity checks of the files, and between checks that originals
# are still online (0 disables them).
ARCHIVER_FIXITY_DAYS=30
ARCHIVER_CHECK_DAYS=7

# Optional: STORAGE_BACKEND=s3 (AWS S3, MinIO, R2, etc.)
S3_BUCKET=
S3_ENDPOINT_URL=
S3_PREFIX=archiver
S3_ADDRESSING_STYLE=auto
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Optional: encrypt files before they are stored (local folder or bucket).
# Create a key with "python run.py keygen" and keep a copy elsewhere: without
# it, encrypted archives cannot be read. See "Encrypted storage" in the README.
ENCRYPTION_KEY=

# Optional: an HTTP proxy for every request to platforms and web pages (not S3).
# host:port, host:port:username:password, or a pool with a port range as
# providers list it (host:10001-10010:username:password). Several, comma-separated.
PROXY=
# always (default): every request goes through PROXY. fallback: an archive is
# tried directly first, and through PROXY only when that attempt fails.
PROXY_MODE=fallback

# Optional: let a relay on another computer archive the links this server
# cannot download (see "Home relay" in the README).
# RELAY_TOKEN is the same on the server and on the relay ("openssl rand -hex 32");
# RELAY_SERVER, on the relay only, is the server's address.
RELAY_TOKEN=
RELAY_SERVER=
