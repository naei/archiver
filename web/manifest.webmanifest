{
  "name": "Archiver",
  "short_name": "Archiver",
  "description": "A personal memory of the web: keep what mattered to you online, before it disappears.",
  "lang": "en",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#14161c",
  "theme_color": "#14161c",
  "icons": [
    {"src": "/icon-192.png", "sizes": "192x192", "type": "image/png"},
    {"src": "/icon-512.png", "sizes": "512x512", "type": "image/png"},
    {"src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml"}
  ],
  "share_target": {
    "action": "/share",
    "method": "GET",
    "params": {"title": "title", "text": "text", "url": "url"}
  }
}
